rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthorizedAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email.matches('.*@campusnotes[.]internal')
      );
    }

    // Study Materials Storage (CSE Semester 5)
    match /materials/{subjectId}/{materialId}/{fileName} {
      // Public visitors may only read published study materials when not in maintenance.
      // Authenticated administrators can read all files (including drafts and maintenance).
      allow read: if isAuthorizedAdmin() || (resource.metadata.published == 'true' && resource.metadata.maintenance != 'true');

      // Only authorized administrators may upload or overwrite
      // Strict constraints: Content-Type must be PDF, max file size 25MB (26214400 bytes)
      allow write: if isAuthorizedAdmin()
                   && request.resource.size <= 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';

      // Only authorized administrators may delete
      allow delete: if isAuthorizedAdmin();
    }

    // Default deny for all other locations
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
